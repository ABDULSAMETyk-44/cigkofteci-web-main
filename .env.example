# =============================================================================
# ADIYAMAN ÇİĞKÖFTE — Ortam Değişkenleri Örneği
# =============================================================================
# Bu dosyayı ".env" olarak kopyalayın ve kendi bilgilerinizle doldurun:
#   cp .env.example .env
#
# .env dosyası ASLA GitHub'a veya herkese açık bir yere yüklenmemelidir.
# =============================================================================

# --- Yönetici Paneli Oturum Güvenliği -------------------------------------
# Oturum çerezlerini imzalamak için kullanılan gizli anahtar.
# Rastgele ve uzun bir değer girin (örn: `openssl rand -hex 32` ile üretebilirsiniz).
ADMIN_SESSION_SECRET=buraya-uzun-ve-rastgele-bir-anahtar-yazin

# --- Varsayılan Yönetici Hesabı (yalnızca ilk kurulumda kullanılır) -------
# data/db.json dosyası ilk kez oluşturulurken bu bilgilerle bir admin
# hesabı otomatik oluşturulur. Kuruluma özel değerler girin, ardından
# panelden (Ayarlar) şifrenizi değiştirin.
DEFAULT_ADMIN_EMAIL=admin@adiyamancigkofte.com
DEFAULT_ADMIN_PASSWORD=Admin123!

# --- E-posta Bildirimleri (SMTP) ------------------------------------------
# Yeni sipariş / mesaj / bayilik başvurusu geldiğinde site sahibine
# e-posta gönderilmesi için SMTP ayarları. Tanımlanmazsa e-posta
# gönderilmez ama bildirimler admin panelinde görünmeye devam eder.
#
# Örnek (Gmail için "Uygulama Şifresi" oluşturmanız gerekir):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=isletmeniz@gmail.com
#   SMTP_PASS=uygulama-sifreniz
#
# Örnek (herhangi bir SMTP sağlayıcısı - SendGrid, Mailgun, Yandex, vb.):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Bildirimlerin gönderileceği e-posta adresi (site sahibi/işletmeci).
NOTIFY_EMAIL=

# E-postalarda "Kimden" alanında görünecek adres (boşsa SMTP_USER kullanılır).
MAIL_FROM=

# --- Sipariş Arşivleme ------------------------------------------------------
# Sonuçlanmış (teslim edildi / iptal) siparişler kaç ay sonra otomatik olarak
# arşive taşınsın? Varsayılan: 6. Aktif süreçteki (yeni/hazırlanıyor/yolda)
# siparişler yaşları ne olursa olsun arşive taşınmaz.
ARCHIVE_AFTER_MONTHS=6
